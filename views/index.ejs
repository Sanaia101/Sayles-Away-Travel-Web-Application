	<title>Our Services</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
        }

		.title {
            text-align: center;
            font-family: 'Georgia', serif; 
            font-size: 2.5rem;
            color: #333;
            margin-top: 20px;
            margin-bottom: 40px;
        }
        .service-container {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 20px;
            padding: 20px;
        }

        .service-card {
            width: 20%;
            background-color: #f9f9f9;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            overflow: hidden;
            transition: transform 0.3s ease;
        }

        .service-card img,
        .service-card video {
            width: 100%;
            height: auto;  
            object-fit: cover;
        }

        .service-card .service-info {
            padding: 15px;
            text-align: center;
        }

        .service-card .service-info h3 {
            margin: 10px 0;
            font-size: 1.2rem;
            color: #333;
        }

        .service-card .service-info p {
            color: #777;
            font-size: 1rem;
        }

        .service-card:hover {
            transform: translateY(-10px);
        }

        @media (max-width: 768px) {
            .service-card {
                width: 48%;
            }
        }

        @media (max-width: 480px) {
            .service-card {
                width: 100%;
            }
        }
	
button[type="submit"]:hover {
    background-color: #009b9b; 
    transition: background-color 0.3s ease;
}


input:focus, textarea:focus {
    outline: none;
    border-color: #ffd700; 
    box-shadow: 0 0 5px rgba(255, 215, 0, 0.8); 
}


label {
    font-weight: bold;
    color: #333;
    margin-bottom: 8px;
}

@media (max-width: 768px) {
    form {
        padding: 10px;
    }
    input, textarea {
        font-size: 16px;
    }
}


