<body>

	<style>

    .side_menu {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 350px;
        height: 100vh;
        background: linear-gradient(to right, #37d7e5, #00b8b8); 
        box-shadow: 2px 0 5px rgba(0, 0, 0, 0.3);
        z-index: 1000;
    }

    .side_menu.active {
        display: block;
    }

    .toggle_icon {
        display: flex;
        flex-direction: column;
        cursor: pointer;
        position: fixed;
        top: 15px;
        left: 15px;
        z-index: 1100;
    }

    .toggle_icon span {
        background-color: #ffffff;
        height: 3px;
        width: 30px;
        margin: 4px 0;
    }

    .menu-close {
        padding: 10px;
        cursor: pointer;
    }

    .list.menu-left li a {
        color: #fff; /* White text color for better contrast */
        text-decoration: none;
        padding: 10px 15px;
        display: block;
        transition: background-color 0.3s ease;
    }

    .list.menu-left li a:hover {
        background-color: rgba(255, 255, 255, 0.2); /* Subtle hover effect */
    }

    .logo img {
        max-width: 90%;
        object-fit: contain;
        height: 150px;
    }

    .carousel-control-prev-icon,
    .carousel-control-next-icon {
    background-color: black;
    background-image: none; 
    width: 40px;
    height: 40px;
    mask-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" fill="white" viewBox="0 0 8 8"><path d="M5 0l-5 4 5 4v-8z"/></svg>');
    -webkit-mask-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" fill="white" viewBox="0 0 8 8"><path d="M5 0l-5 4 5 4v-8z"/></svg>');
    }

    .carousel-control-next-icon {
    mask-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" fill="white" viewBox="0 0 8 8"><path d="M3 0l5 4-5 4v-8z"/></svg>');
    -webkit-mask-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" fill="white" viewBox="0 0 8 8"><path d="M3 0l5 4-5 4v-8z"/></svg>');
    }
    .carousel-indicators li {
    background-color: black;   /* Black dots */
    border: none;              /* Removes the white border */
    width: 10px;               /* Adjust size for a sleeker look */
    height: 10px;              
    border-radius: 50%;        /* Makes them circular */
    opacity: 0.7;              /* Slight transparency for elegance */
}

.carousel-indicators .active {
    background-color: black;   /* Ensures active dot is also black */
    opacity: 1;                /* Fully visible when active */
}




    </style>
</head>

